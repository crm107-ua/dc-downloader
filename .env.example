# === Discord (obligatorio) ===
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Allowlist de guilds (vacío = todos los servidores donde esté el bot)
DISCORD_ALLOWED_GUILD_IDS=

# Mantenimiento: 1 = responde "Servidor apagado, prueba más tarde."
BOT_OFFLINE=0

# === Límites ===
MAX_DURATION_SECONDS=1800
MAX_FILE_SIZE_MB=10
TEMP_DIR=./temp
TEMP_MAX_AGE_HOURS=24

# === Cookies opcionales (yt-dlp) ===
COOKIES_FILE=
COOKIES_FROM_BROWSER=

# === Binarios (vacío = sistema / PATH / scripts/ensure-bins → bin/) ===
FFMPEG_BIN=
FFPROBE_BIN=
YT_DLP_BIN=

# === Cloudflare R2 (vídeos >5 min; 0 = desactivado) ===
R2_ENABLED=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dc-downloader
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-<bucketid>.r2.dev
R2_LONG_VIDEO_SECONDS=300
R2_MAX_STORAGE_GB=9
