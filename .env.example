DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: comma-separated Discord guild IDs. Leave empty to allow any server.
DISCORD_ALLOWED_GUILD_IDS=
# Optional: Netscape cookies file for X/Reddit/Instagram age walls
COOKIES_FILE=
# Optional: e.g. chrome, edge, firefox (helps Reddit / YouTube / Instagram age walls)
COOKIES_FROM_BROWSER=
MAX_DURATION_SECONDS=600
MAX_FILE_SIZE_MB=10
TEMP_DIR=./temp
# Auto-delete TEMP_DIR (+ R2 objects) older than this when a new download starts
TEMP_MAX_AGE_HOURS=24

# Cloudflare R2 — videos longer than R2_LONG_VIDEO_SECONDS (default 300) upload here
# at high quality and Discord plays the public MP4 URL (inline player).
R2_ENABLED=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dc-downloader
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-<bucketid>.r2.dev
R2_LONG_VIDEO_SECONDS=300
MAX_DURATION_R2_SECONDS=7200
