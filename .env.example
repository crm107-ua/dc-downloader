DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: comma-separated Discord guild IDs. Leave empty to allow any server.
DISCORD_ALLOWED_GUILD_IDS=
# Manual offline mode: all slash commands reply "Servidor apagado, prueba más tarde."
# BOT_OFFLINE=1

# Optional: Netscape cookies file for X/Reddit/Instagram / YouTube age walls
COOKIES_FILE=
# Optional: e.g. chrome, edge, firefox
COOKIES_FROM_BROWSER=
# Global max duration (seconds) for all providers — default 30 min
MAX_DURATION_SECONDS=1800
MAX_FILE_SIZE_MB=10
TEMP_DIR=./temp
# Local VPS temp job GC (hours). Does NOT apply to R2 objects.
TEMP_MAX_AGE_HOURS=24

# Cloudflare R2 — videos longer than R2_LONG_VIDEO_SECONDS upload here (no 10 MB compress)
R2_ENABLED=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dc-downloader
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-<bucketid>.r2.dev
R2_LONG_VIDEO_SECONDS=300
# Soft cap under Cloudflare free 10 GB — FIFO deletes oldest when exceeded
R2_MAX_STORAGE_GB=9
